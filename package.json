{
  "name": "@infisical/cipher",
  "version": "0.1.1",
  "description": "Cipher, Infisical's design system: React components, tokens and themes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Infisical/cipher.git"
  },
  "homepage": "https://github.com/Infisical/cipher#readme",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./styles.css": "./dist/cipher.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./modules.css": "./dist/modules.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./scope": {
      "types": "./dist/scope.d.ts",
      "default": "./dist/scope.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "default": "./dist/ui/*.js"
    },
    "./patterns/*": {
      "types": "./dist/patterns/*.d.ts",
      "default": "./dist/patterns/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "motion": "^13.2.0 || ^14.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.14"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.544.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.2",
    "tailwind-merge": "^2.5.5",
    "tw-animate-css": "^1.4.0"
  }
}
