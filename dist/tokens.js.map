  "spacing": {
    "note": "The number is the pixel value. Layouts use the larger steps; controls use 6 to 16.",
    "tokens": [
      {
        "name": "space-2",
        "value": "2px",
        "usage": "Between icon buttons in a toolbar; title to description in stacked text; tile to tile inside a stepper."
      },
      {
        "name": "space-3",
        "value": "3px",
        "usage": "Shell inset: between a tint shell and its content block (cards, tables, lists). Segmented track padding. Menu and listbox padding, so a row's hover ground sits 4px from the outer edge with the border. A field's end padding beside its nested items, so a slot sits 4px from the outer edge with the border."
      },
      {
        "name": "space-4",
        "value": "4px",
        "usage": "Gap inside segmented tracks and pagination; between step segments; between grouped nested items in a field (reveal and copy, a shortcut and clear)."
      },
      {
        "name": "space-6",
        "value": "6px",
        "usage": "Label to control; badge dot to text; small button icon gap; combobox chip field padding."
      },
      {
        "name": "space-8",
        "value": "8px",
        "usage": "Icon to label in buttons and inputs; buttons inside a row or item."
      },
      {
        "name": "space-10",
        "value": "10px",
        "usage": "Small button padding; avatar to name; left and right padding inside text fields, input groups and select, combobox and multiselect triggers. Menu and listbox rows reach the same line: 3px list padding plus 7px row padding, so their text lines up with the trigger's."
      },
      {
        "name": "space-12",
        "value": "12px",
        "usage": "Popover padding, both directions; gap between buttons in footers; dialog and sheet footer padding; gap between stacked blocks; alert grid gap."
      },
      {
        "name": "space-14",
        "value": "14px",
        "usage": "Row padding in tables and item lists; default button padding; section heading to content."
      },
      {
        "name": "space-16",
        "value": "16px",
        "usage": "Card, alert and alert dialog padding; gap between fields in a form."
      },
      {
        "name": "space-20",
        "value": "20px",
        "usage": "Dialog and sheet body padding; gap between checkbox options."
      },
      {
        "name": "space-24",
        "value": "24px",
        "usage": "Gap between side by side cards; combobox chip height; gap between header and nav."
      },
      {
        "name": "space-32",
        "value": "32px",
        "usage": "Gap between side by side sections."
      },
      {
        "name": "space-40",
        "value": "40px",
        "usage": "Main panel padding; compact list row and tab height."
      },
      {
        "name": "space-44",
        "value": "44px",
        "usage": "Gap between page sections."
      },
      {
        "name": "space-48",
        "value": "48px",
        "usage": "Main panel bottom padding; the TopBar height (size-shell-bar). Table rows are size-row (40px), not this."
      },
      {
        "name": "space-control-inline-sm",
        "value": "{space-10}",
        "usage": "Compact action inline inset. Also the inline padding of sm (32px) fields and the inset of their leading icon and chevron."
      },
      {
        "name": "space-control-inline-md",
        "value": "{space-12}",
        "usage": "Inline padding of md (36px) fields. Field padding steps 10, 12, 14 with the 32, 36, 40 heights, and a leading icon sits at the same inset."
      },
      {
        "name": "space-control-inline",
        "value": "{space-14}",
        "usage": "Ordinary and large action inline inset. Also the inline padding of lg (40px) fields."
      },
      {
        "name": "space-control-gap",
        "value": "{space-6}",
        "usage": "Action icon and label gap."
      },
      {
        "name": "space-field-label",
        "value": "{space-6}",
        "usage": "Field label to its control and supporting feedback."
      },
      {
        "name": "space-field-group",
        "value": "{space-16}",
        "usage": "Between complete field groups."
      },
      {
        "name": "space-content-group",
        "value": "{space-16}",
        "usage": "Related blocks inside a content section."
      },
      {
        "name": "space-actions-gap",
        "value": "{space-12}",
        "usage": "Space between a text block and the action row under it: Item and List rows with actions below, Announcements, ApprovalQueue and Alert actions. Set as a gap (or the block padding of the action row in a tighter stack), never a margin on the buttons."
      },
      {
        "name": "space-content-section",
        "value": "{space-32}",
        "usage": "Between independent open content sections."
      },
      {
        "name": "space-shell-gap",
        "value": "{space-8}",
        "usage": "Gap on the right and bottom of the AppInset island (and on its top when there is no TopBar band, and its left when there is no sidebar), so the inset floats on the shell ground as a framed card."
      },
      {
        "name": "space-crumb-divider",
        "value": "{space-8}",
        "usage": "Space on each side of a BandDivider, between the line and the ground of the target beside it: crumbs in either Breadcrumb variant and the TopBar's right cluster. The divider is an element in the layout flow, so both sides are always equal and no neighbor offsets it."
      },
      {
        "name": "size-shell-bar",
        "value": "{space-48}",
        "usage": "Height of the TopBar band across the top of the AppShell, on the shell ground and outside the AppInset island. The island and the Sidebar both start below it."
      },
      {
        "name": "space-sidebar-row-inset",
        "value": "9px",
        "usage": "Inline padding of a Sidebar nav row, so its 18px glyph sits centered in the 36px rail row. The TopBar organization switcher uses it too, so its glyph and label line up with the rows below."
      },
      {
        "name": "size-sidebar-icon",
        "value": "18px",
        "usage": "Glyph of a Sidebar nav row and of the TopBar organization switcher above it."
      },
      {
        "name": "size-shell-target",
        "value": "{size-control-sm}",
        "usage": "Hover and press box height of every target in the TopBar band: crumb names, switcher chevrons, the organization switcher, the search and notification icon buttons and the account trigger. One height, centered in size-shell-bar, so no ground is taller or shorter than its neighbors. It equals the default Button height, so the band's Buttons use size sm."
      },
      {
        "name": "size-shell-collapse",
        "value": "800px",
        "usage": "AppShell width below which the Sidebar has no rail and opens only as a left Sheet from the TopBar menu button, the band keeps at most two crumbs, and the AppInset island drops its gaps and border to fill the shell. Measured on the shell itself, so an embedded shell collapses by its own width."
      },
      {
        "name": "size-shell-rail",
        "value": "1280px",
        "usage": "AppShell width below which the Sidebar starts as the rail, and expanding it opens the full navigation as a left Sheet with a scrim instead of pushing the island. At this width and above the Sidebar starts expanded. Measured on the shell itself."
      },
      {
        "name": "size-sidebar",
        "value": "224px",
        "usage": "Width of the expanded Sidebar. In the wide shell the TopBar's organization switcher fills it, so the divider after the switcher lines up with the island's left edge."
      },
      {
        "name": "size-sidebar-rail",
        "value": "52px",
        "usage": "Width of the collapsed Sidebar rail. Its 36px tools sit on the same 26px center line as the expanded corner toggle, so the toggle never moves."
      },
      {
        "name": "size-unread",
        "value": "6px",
        "usage": "The unread square on the notifications button, the announcements trigger and the narrow menu button, in accent-fg with a ring of the ground behind it."
      },
      {
        "name": "size-touch-row",
        "value": "{space-48}",
        "usage": "Rows of the shell's bottom sheets (account and help below size-shell-collapse) and the nav Sheet's user row, sized for touch."
      },
      {
        "name": "space-surface-inset",
        "value": "{space-16}",
        "usage": "Ordinary surface header, body and footer alignment edge."
      },
      {
        "name": "space-surface-inset-sm",
        "value": "{space-12}",
        "usage": "Compact surface header, body and footer alignment edge."
      },
      {
        "name": "space-overlay-inset",
        "value": "{space-20}",
        "usage": "Modal and sheet content alignment edge."
      },
      {
        "name": "space-menu-inset",
        "value": "{space-3}",
        "usage": "Menu rows inset inside their containing border."
      },
      {
        "name": "space-control-slot-inset",
        "value": "{space-3}",
        "usage": "Interior field inset. With the 1px border, a nested action sits 4px from the host outside edge."
      },
      {
        "name": "space-control-slot-gap",
        "value": "{space-4}",
        "usage": "Between separate actions in one field slot."
      },
      {
        "name": "space-row-inline",
        "value": "{space-surface-inset-sm}",
        "usage": "Inline padding of every Table and DataTable cell: the 12px content edge that cell text and row indicator glyphs share. The sticky actions cell pads by space-row-actions-inset instead."
      },
      {
        "name": "space-row-actions-gap",
        "value": "0px",
        "usage": "Gap between row action targets and between row indicator slots. Neighbouring targets touch without overlapping, so 16px glyphs sit 12px apart."
      },
      {
        "name": "space-row-actions-inset",
        "value": "calc(({size-row} - {size-target-row}) / 2 - {size-control-border})",
        "usage": "Inline padding on both sides of the sticky actions cell, inside its divider and the frame edge. With the 1px lines on either side it centers one size-target-row action in a size-row square, 5px clear of each line."
      },
      {
        "name": "space-row-indent",
        "value": "{space-24}",
        "usage": "One depth step of a DataTable row's primary cell: rows under a group header and child rows from getRowChildren start this far inside the column's content edge. It equals an icon plus its 8px gap, so a child's text lines up with the label after its parent's icon."
      },
      {
        "name": "size-action-bar",
        "value": "{space-48}",
        "usage": "Height of the FloatingActionBar. While the bar shows, AppInset adds this plus space-action-bar-offset as bottom padding, so the last row and the pagination can scroll clear of it."
      },
      {
        "name": "space-action-bar-offset",
        "value": "{space-24}",
        "usage": "Gap between the FloatingActionBar and the bottom of the window."
      }
    ]
  },
  "size": {
    "note": "Heights shared by controls and badges, so they line up in any row, and the slot that nested items take inside a field (size-nested-*: the field height minus 8px). The width floors live here too: size-cell-min for table columns, size-text-min for item and card text, size-tile-min for tile grids.",
    "tokens": [
      {
        "name": "size-badge-sm",
        "value": "16px",
        "usage": "Small badge height, inside table rows, item rows and sheet meta."
      },
      {
        "name": "size-count",
        "value": "20px",
        "usage": "Count chip height, in navigation and tabs."
      },
      {
        "name": "size-badge",
        "value": "20px",
        "usage": "Default badge height: identity, status and emphasis. Matches the count chip."
      },
      {
        "name": "size-kbd-xs",
        "value": "16px",
        "usage": "Kbd key cap on ink, inside tooltips. A single-glyph cap is exactly this square; longer labels keep the height and grow in width."
      },
      {
        "name": "size-kbd-sm",
        "value": "18px",
        "usage": "Small Kbd key cap, in menus, command rows, buttons and the TopBar search. A single-glyph cap is an 18px square; Ctrl, Shift and Esc keep the height and grow with equal side padding."
      },
      {
        "name": "size-kbd-md",
        "value": "20px",
        "usage": "Default Kbd key cap, in running text and field hints. A single-glyph cap is a 20px square; longer labels keep the height and grow with equal side padding."
      },
      {
        "name": "size-control-sm",
        "value": "32px",
        "usage": "Small control height: small buttons and inputs, icon buttons in toolbars, menu items and options, segmented items, pagination pages."
      },
      {
        "name": "size-control-md",
        "value": "36px",
        "usage": "Explicit comfortable md control height. Use size=md with iconOnly for a matching 36px standalone icon action. The ordinary default is 32px. Legacy icon aliases keep their explicit nested sizes."
      },
      {
        "name": "size-control-lg",
        "value": "40px",
        "usage": "Large control height: large buttons and inputs."
      },
      {
        "name": "size-row-stacked",
        "value": "48px",
        "usage": "Height of a row whose label stacks two lines (a small title over a caption subtitle, 34px of text), such as the option rows of a stacked picker. A 36px control row is too short for two lines."
      },
      {
        "name": "size-nested-sm",
        "value": "24px",
        "usage": "Slot for a nested item inside a small (32px) field: icon buttons, shortcut hints, clear buttons. 4px from the field's outer edge on every side."
      },
      {
        "name": "size-nested-md",
        "value": "28px",
        "usage": "Slot for a nested item inside an explicit comfortable md (36px) field: reveal, copy and clear icon buttons, a Kbd hint or a small Badge. The ordinary default uses nested-default at 24px. This explicit slot sits 4px from the field's outer edge; slots are 4px apart."
      },
      {
        "name": "size-nested-lg",
        "value": "32px",
        "usage": "Slot for a nested item inside a large (40px) field."
      },
      {
        "name": "size-cell-min",
        "value": "64px",
        "usage": "Floor for every Table and DataGrid column that fits its content. A column can set its own minWidth, or a fixed width."
      },
      {
        "name": "size-text-min",
        "value": "160px",
        "usage": "Floor for the main text of an item row and of a plain card heading. Buttons and badges beside it keep their width and drop under the text instead of squeezing it; the text truncates, with its full value on hover."
      },
      {
        "name": "size-tile-min",
        "value": "208px",
        "usage": "Narrowest a Tile gets in an ifs-tiles grid; below it the grid drops a column instead of squeezing tiles."
      },
      {
        "name": "size-card-min",
        "value": "320px",
        "usage": "Narrowest a Card gets in an auto-fit Grid (Grid min=\"card\"); below it the grid drops to fewer columns, so DataList rows keep their label and value on one line."
      },
      {
        "name": "size-tooltip-max",
        "value": "320px",
        "usage": "Widest a Tooltip grows; longer text wraps inside it instead of overflowing. Tooltip content always resets white-space, so a trigger inside a nowrap cell never forces one long line."
      },
      {
        "name": "size-menu-min",
        "value": "160px",
        "usage": "Narrowest a menu, listbox or command list panel gets. A panel is never narrower than its trigger either, and grows with its widest row up to size-menu-max."
      },
      {
        "name": "size-menu-max",
        "value": "320px",
        "usage": "Widest a menu or listbox panel grows from its content. A trigger wider than this still sets the panel's minimum; rows past it truncate their label instead of wrapping."
      },
      {
        "name": "size-popover",
        "value": "288px",
        "usage": "Width of a popover and a hover card, both padded space-12."
      },
      {
        "name": "size-toast",
        "value": "400px",
        "usage": "Maximum width of a toast. A ToastStack is as wide as its widest title or description up to this width, so a short notice stays compact and a long title wraps to two lines instead of a tall, narrow card; actions never widen it. The Sonner Toaster draws every toast at this width."
      },
      {
        "name": "size-dialog",
        "value": "440px",
        "usage": "Maximum width of an ordinary dialog and alert dialog."
      },
      {
        "name": "size-dialog-wide",
        "value": "560px",
        "usage": "Maximum width of the command palette dialog: a search row and result rows with room for descriptions and shortcuts."
      },
      {
        "name": "size-sheet-sm",
