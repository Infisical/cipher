      {
        "name": "shadow-pop",
        "value": {
          "light": "0 16px 40px rgba(1, 1, 1, 0.14), 0 2px 6px rgba(1, 1, 1, 0.08)",
          "dark": "0 16px 40px rgba(0, 0, 0, 0.7), 0 2px 6px rgba(0, 0, 0, 0.5)"
        },
        "usage": "Menus, listboxes, popovers, dialogs, sheets, toasts."
      },
      {
